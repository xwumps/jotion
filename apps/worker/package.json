{
  "name": "@jotion/worker",
  "version": "1.0.0",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "healthcheck": "node dist/healthcheck.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run"
  },
  "dependencies": {
    "@jotion/compute": "workspace:*",
    "@jotion/db": "workspace:*",
    "@jotion/integrations": "workspace:*",
    "@jotion/editor": "workspace:*",
    "@jotion/shared": "workspace:*",
    "bullmq": "5.81.5",
    "ioredis": "5.11.1",
    "pino": "9.14.0",
    "yjs": "13.6.33"
  },
  "devDependencies": {
    "@jotion/config": "workspace:*",
    "pino-pretty": "13.2.0",
    "tsx": "4.23.15",
    "vitest": "3.2.7"
  }
}
