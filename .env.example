# Jotion Konfiguration. Kopie als .env anlegen: `pnpm init` bzw. `bash scripts/init.sh`
# erzeugt sichere Zufallswerte für alle Secrets.

# Öffentliche Adresse, unter der Jotion im Browser erreichbar ist (ohne abschließenden Slash)
JOTION_PUBLIC_URL=http://localhost:8080
# Port, auf dem Caddy auf dem Host lauscht
JOTION_HTTP_PORT=8080
# Für eigene Domain mit Auto-HTTPS: Domain eintragen (z. B. jotion.example.org), sonst ":80"
JOTION_SITE_ADDRESS=:80
JOTION_DEFAULT_LOCALE=de
LOG_LEVEL=info

# PostgreSQL
POSTGRES_USER=jotion
POSTGRES_PASSWORD=change-me
POSTGRES_DB=jotion
DATABASE_URL=postgresql://jotion:change-me@localhost:5432/jotion

# Redis
REDIS_PASSWORD=change-me
REDIS_URL=redis://:change-me@localhost:6379

# Secrets (32 Byte, base64). NIEMALS verlieren: ohne Master Key sind gespeicherte
# Integrations-Zugangsdaten nicht mehr lesbar. Separat sichern!
JOTION_MASTER_KEY=
AUTH_SECRET=

# Interne Adresse der API für serverseitige Aufrufe aus dem Web-Container
API_INTERNAL_URL=http://localhost:4000

# Nur für Builds hinter einem TLS-abfangenden Proxy (Firma, Schule): Pfad zu einer
# zusätzlichen CA-Datei (PEM) innerhalb des Projekts, z. B. ./docker/data/extra-ca.pem
# (Ordner ist von git ausgeschlossen). Sonst leer lassen.
JOTION_BUILD_CA=
