# Jotion Konfiguration. Kopie als .env anlegen: `pnpm init` bzw. `bash scripts/init.sh`
# erzeugt sichere Zufallswerte für alle Secrets.

# Öffentliche Adresse, unter der Jotion im Browser erreichbar ist (ohne abschließenden Slash)
JOTION_PUBLIC_URL=http://localhost:8080
# Port, auf dem Caddy auf dem Host lauscht
JOTION_HTTP_PORT=8080
# Für eigene Domain mit Auto-HTTPS: Domain eintragen (z. B. jotion.example.org), sonst ":80"
JOTION_SITE_ADDRESS=:80
JOTION_DEFAULT_LOCALE=de
LOG_LEVEL=info

# PostgreSQL
POSTGRES_USER=jotion
POSTGRES_PASSWORD=change-me
POSTGRES_DB=jotion
DATABASE_URL=postgresql://jotion:change-me@localhost:5432/jotion

# Redis
REDIS_PASSWORD=change-me
REDIS_URL=redis://:change-me@localhost:6379

# Secrets (32 Byte, base64). NIEMALS verlieren: ohne Master Key sind gespeicherte
# Integrations-Zugangsdaten nicht mehr lesbar. Separat sichern!
JOTION_MASTER_KEY=
AUTH_SECRET=
# Nach einem Schlüsselwechsel: alte Master Keys (kommagetrennt), damit gespeicherte
# Zugangsdaten lesbar bleiben; sie werden beim nächsten Zugriff neu verschlüsselt.
JOTION_MASTER_KEY_PREVIOUS=

# Höchstgröße allgemeiner Datei-Uploads in MB (Bilder sind auf 10 MB begrenzt)
JOTION_MAX_UPLOAD_MB=100
# Hosts oder IP-Bereiche, die Link-Vorschauen und Integrationen (CalDAV, iCal) trotz
# privater Adresse abrufen dürfen, z. B. eine Nextcloud im LAN
# (kommagetrennt, z. B. wiki.intern,10.0.5.0/24). Standard: leer = nur öffentliche Ziele.
JOTION_SSRF_ALLOWLIST=

# OAuth-Apps für Google (Kalender, Gmail, Drive), Microsoft 365 (Outlook, OneDrive) und Dropbox.
# Je Anbieter eine eigene App registrieren, Rückleitungs-URL:
#   <JOTION_PUBLIC_URL>/api/integrations/oauth/callback
# Leer lassen, wenn der Anbieter nicht gebraucht wird. Details: docs/operations.md
JOTION_GOOGLE_CLIENT_ID=
JOTION_GOOGLE_CLIENT_SECRET=
JOTION_MICROSOFT_CLIENT_ID=
JOTION_MICROSOFT_CLIENT_SECRET=
JOTION_MICROSOFT_TENANT=common
JOTION_DROPBOX_CLIENT_ID=
JOTION_DROPBOX_CLIENT_SECRET=

# Interne Adresse der API für serverseitige Aufrufe aus dem Web-Container
API_INTERNAL_URL=http://localhost:4000

# Nur für Builds hinter einem TLS-abfangenden Proxy (Firma, Schule): Pfad zu einer
# zusätzlichen CA-Datei (PEM) innerhalb des Projekts, z. B. ./docker/data/extra-ca.pem
# (Ordner ist von git ausgeschlossen). Sonst leer lassen.
JOTION_BUILD_CA=

# Phase 6: Zeitzone für Datumsfunktionen in Formeln (now(), today(), formatDate)
JOTION_TIMEZONE=Europe/Berlin

# Phase 12: Automatische Sicherungen (Dienst "backup", Ablage im Volume "backups").
# Uhrzeit HH:MM in JOTION_TIMEZONE. Aufbewahrung: je Tag, je Woche, vor Updates, manuell.
JOTION_BACKUP_ENABLED=true
JOTION_BACKUP_TIME=03:15
JOTION_BACKUP_KEEP_DAILY=7
JOTION_BACKUP_KEEP_WEEKLY=4
JOTION_BACKUP_KEEP_PRE_UPDATE=3
JOTION_BACKUP_KEEP_MANUAL=5

# Phase 12.1: Sicherungen verschlüsseln (Schlüssel aus JOTION_MASTER_KEY abgeleitet).
# false = unverschlüsselt. Verschlüsselte Sicherungen lassen sich nur mit dem Master Key
# von damals öffnen (aktuell oder in JOTION_MASTER_KEY_PREVIOUS).
JOTION_BACKUP_ENCRYPT=true

# Phase 12: Prometheus-Metriken unter /api/metrics, Abruf mit
# "Authorization: Bearer <Token>". Leer = Endpunkt abgeschaltet.
JOTION_METRICS_TOKEN=

# Phase 12.2: Fertige Images aus der GitHub Container Registry statt selbst bauen.
# Setzen auf ghcr.io/xwumps/jotion, dann scripts/update.sh ausführen (trägt JOTION_VERSION ein).
# Leer = Images werden aus dem Quellcode gebaut (Standard).
JOTION_IMAGE_PREFIX=
# Version der Images (setzt scripts/update.sh). Ohne JOTION_IMAGE_PREFIX: Name lokal gebauter Images.
# JOTION_VERSION=
# Hinweis auf neue Versionen im Admin-Bereich: fragt höchstens einmal am Tag die öffentliche
# Release-Liste auf GitHub ab, nur wenn ein Admin den Bereich öffnet. false = nie.
JOTION_UPDATE_CHECK=true
