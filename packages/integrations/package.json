{
  "name": "@jotion/integrations",
  "version": "0.1.0",
  "private": true,
  "description": "Integrationen: sicherer HTTP-Client, Verschlüsselung, iCal/CalDAV, Connectoren, Mapping und Sync",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run"
  },
  "dependencies": {
    "@jotion/db": "workspace:*",
    "@jotion/query": "workspace:*",
    "@jotion/shared": "workspace:*",
    "fast-xml-parser": "5.11.2",
    "ical.js": "2.1.0"
  },
  "devDependencies": {
    "@jotion/config": "workspace:*",
    "fast-check": "4.10.2",
    "vitest": "3.2.7"
  }
}
