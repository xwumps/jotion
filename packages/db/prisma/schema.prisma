// Jotion Datenmodell. Siehe docs/architecture/03-datenmodell.md
// Weitere Modelle folgen phasenweise über eigene Migrationen.
// Spalten in snake_case, Tabellen im Plural. IDs: UUIDv7 (zeitlich sortierbar).

generator client {
  provider      = "prisma-client-js"
  // Fester Ausgabeort im Package, unabhängig vom pnpm-Layout (lokal und in Docker)
  output        = "../generated/client"
  // native für Entwicklung, musl für die Alpine-Images (x86_64 und ARM64, z. B. Raspberry Pi / NAS)
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Instanzweite Einstellungen (Branding, Feature-Flags, Schema-Version der Daten).
model SystemSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("system_settings")
}

// ---------------------------------------------------------------------------
// Phase 1: Identität, Workspaces, Seitenbaum
// ---------------------------------------------------------------------------

enum WorkspaceRole {
  OWNER
  MEMBER
}

/// PRIVATE: nur für den Ersteller sichtbar. TEAM: für alle Mitglieder des Workspace.
enum PageScope {
  PRIVATE
  TEAM
}

model User {
  id           String    @id @default(uuid(7)) @db.Uuid
  /// immer kleingeschrieben gespeichert
  email        String    @unique
  name         String
  passwordHash String    @map("password_hash")
  locale       String?
  disabledAt   DateTime? @map("disabled_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  sessions     Session[]
  memberships  WorkspaceMember[]
  favorites    Favorite[]
  pageVisits   PageVisit[]
  resetTokens  PasswordResetToken[] @relation("ResetTokenUser")
  createdPages Page[]               @relation("PageCreatedBy")
  ownedPages   Page[]               @relation("PageOwner")

  @@map("users")
}

model Session {
  id         String   @id @default(uuid(7)) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  /// SHA-256 des Cookie-Tokens, das Token selbst wird nie gespeichert
  tokenHash  String   @unique @map("token_hash")
  userAgent  String?  @map("user_agent")
  ip         String?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model PasswordResetToken {
  id          String    @id @default(uuid(7)) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  tokenHash   String    @unique @map("token_hash")
  createdById String?   @map("created_by_id") @db.Uuid
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt      DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation("ResetTokenUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model Workspace {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String
  icon      Json?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  members                WorkspaceMember[]
  invitations            Invitation[]
  pages                  Page[]
  files                  File[]
  dashboards             Dashboard[]
  integrationConnections IntegrationConnection[]
  automations            Automation[]
  pagePermissions        PagePermission[]
  comments               Comment[]
  notifications          Notification[]

  @@map("workspaces")
}

model WorkspaceMember {
  workspaceId String        @map("workspace_id") @db.Uuid
  userId      String        @map("user_id") @db.Uuid
  role        WorkspaceRole @default(MEMBER)
  joinedAt    DateTime      @default(now()) @map("joined_at") @db.Timestamptz(3)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([workspaceId, userId])
  @@index([userId])
  @@map("workspace_members")
}

model Invitation {
  id          String        @id @default(uuid(7)) @db.Uuid
  workspaceId String        @map("workspace_id") @db.Uuid
  tokenHash   String        @unique @map("token_hash")
  role        WorkspaceRole @default(MEMBER)
  /// optional: Hinweis, für wen der Link gedacht ist
  note        String?
  createdById String        @map("created_by_id") @db.Uuid
  expiresAt   DateTime      @map("expires_at") @db.Timestamptz(3)
  maxUses     Int           @default(1) @map("max_uses")
  uses        Int           @default(0)
  revokedAt   DateTime?     @map("revoked_at") @db.Timestamptz(3)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("invitations")
}

/// Seite im Baum. `path` (ltree) und `scope` werden per Trigger aus dem Elternteil
/// abgeleitet, siehe Migration 20261102010000_phase1. Nie manuell setzen.
model Page {
  id             String               @id @default(uuid(7)) @db.Uuid
  workspaceId    String               @map("workspace_id") @db.Uuid
  parentId       String?              @map("parent_id") @db.Uuid
  path           Unsupported("ltree") @default(dbgenerated("''::ltree"))
  /// Fractional Index für die Reihenfolge unter Geschwistern
  position       String
  title          String               @default("")
  icon           Json?
  cover          Json?
  scope          PageScope            @default(TEAM)
  /// Ersteller der Wurzelseite; bei PRIVATE der einzige mit Zugriff
  ownerId        String               @map("owner_id") @db.Uuid
  settings       Json                 @default("{}")
  createdById    String               @map("created_by_id") @db.Uuid
  lastEditedById String               @map("last_edited_by_id") @db.Uuid
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  lastEditedAt   DateTime             @default(now()) @map("last_edited_at") @db.Timestamptz(3)
  archivedAt     DateTime?            @map("archived_at") @db.Timestamptz(3)
  /// Phase 9: eigene Vorlage (erscheint in der Vorlagen-Galerie)
  isTemplate     Boolean              @default(false) @map("is_template")
  deletedAt      DateTime?            @map("deleted_at") @db.Timestamptz(3)
  deletedById    String?              @map("deleted_by_id") @db.Uuid
  /// Seite, mit der dieser Teilbaum in den Papierkorb kam (Wiederherstellung als Einheit)
  trashRootId    String?              @map("trash_root_id") @db.Uuid
  /// Phase 4: Seite, Datenbank (Full-Page oder Inline) oder Datenbankzeile
  kind           PageKind             @default(PAGE)
  /// Phase 4: bei Zeilen die Datenbank (immer gleich parentId), sonst null
  databaseId     String?              @map("database_id") @db.Uuid

  workspace        Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  parent           Page?            @relation("PageTree", fields: [parentId], references: [id], onDelete: Cascade)
  children         Page[]           @relation("PageTree")
  owner            User             @relation("PageOwner", fields: [ownerId], references: [id])
  createdBy        User             @relation("PageCreatedBy", fields: [createdById], references: [id])
  favorites        Favorite[]
  visits           PageVisit[]
  doc              PageDoc?
  docUpdates       PageDocUpdate[]
  blocks           Block[]
  blockReferences  BlockReference[]
  databaseInfo     Database?        @relation("DatabasePage")
  database         Database?        @relation("DatabaseRows", fields: [databaseId], references: [id], onDelete: Cascade)
  propertyValues   PropertyValue[]
  relationsFrom    RelationLink[]   @relation("RelationFrom")
  relationsTo      RelationLink[]   @relation("RelationTo")
  externalEntities ExternalEntity[]
  permissions      PagePermission[]
  shareLink        PageShareLink?
  comments         Comment[]
  notifications    Notification[]
  snapshots        PageSnapshot[]

  @@index([workspaceId, parentId, position])
  @@index([databaseId, position])
  @@index([workspaceId, deletedAt])
  @@index([trashRootId])
  @@map("pages")
}

model Favorite {
  userId    String   @map("user_id") @db.Uuid
  pageId    String   @map("page_id") @db.Uuid
  position  String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@id([userId, pageId])
  @@map("favorites")
}

model PageVisit {
  userId    String   @map("user_id") @db.Uuid
  pageId    String   @map("page_id") @db.Uuid
  visitedAt DateTime @default(now()) @map("visited_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@id([userId, pageId])
  @@index([userId, visitedAt(sort: Desc)])
  @@map("page_visits")
}

model File {
  id           String   @id @default(uuid(7)) @db.Uuid
  workspaceId  String   @map("workspace_id") @db.Uuid
  storageKey   String   @unique @map("storage_key")
  mime         String
  size         Int
  sha256       String
  width        Int?
  height       Int?
  originalName String?  @map("original_name")
  uploadedById String   @map("uploaded_by_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("files")
}

/// Transactional Outbox: Domänenereignisse, in derselben Transaktion wie die Änderung geschrieben.
model ChangeEvent {
  id             BigInt    @id @default(autoincrement())
  workspaceId    String    @map("workspace_id") @db.Uuid
  type           String
  entityId       String    @map("entity_id") @db.Uuid
  /// PRIVATE-Ereignisse gehen nur an diesen Nutzer
  audienceUserId String?   @map("audience_user_id") @db.Uuid
  payload        Json      @default("{}")
  actorId        String?   @map("actor_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  publishedAt    DateTime? @map("published_at") @db.Timestamptz(3)

  @@index([publishedAt, id])
  @@map("change_events")
}

// ---------------------------------------------------------------------------
// Phase 2: Seiteninhalt (Yjs) und abgeleitete Block-Projektion
// ---------------------------------------------------------------------------

/// Kompaktierter Yjs-Zustand einer Seite. Quelle der Wahrheit für den Inhalt
/// zusammen mit den noch nicht kompaktierten Einträgen in page_doc_updates.
model PageDoc {
  pageId    String   @id @map("page_id") @db.Uuid
  state     Bytes
  /// Wird bei jeder Kompaktierung erhöht
  version   Int      @default(0)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@map("page_docs")
}

/// Append-only Protokoll eingehender Yjs-Updates. Wird gespeichert, BEVOR der Server
/// das Update anwendet und dem Client bestätigt. Kompaktierung entfernt enthaltene Einträge.
model PageDocUpdate {
  id        BigInt   @id @default(autoincrement())
  pageId    String   @map("page_id") @db.Uuid
  update    Bytes
  userId    String?  @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([pageId, id])
  @@map("page_doc_updates")
}

/// Projektion der Blöcke aus dem Yjs-Dokument (für Suche, Verweise, Export).
/// Wird bei jeder Kompaktierung neu geschrieben; nie als Quelle der Wahrheit lesen.
model Block {
  pageId        String  @map("page_id") @db.Uuid
  /// Block-ID aus dem Dokument (Attribut id)
  id            String
  parentBlockId String? @map("parent_block_id")
  type          String
  position      Int
  plainText     String  @default("") @map("plain_text")
  props         Json    @default("{}")

  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@id([pageId, id])
  @@map("blocks")
}

/// Verweise aus Blöcken auf andere Seiten (Unterseiten-Blöcke, Seitenlinks).
model BlockReference {
  pageId     String @map("page_id") @db.Uuid
  blockId    String @map("block_id")
  targetType String @map("target_type")
  targetId   String @map("target_id") @db.Uuid

  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@id([pageId, blockId, targetId])
  @@index([targetId])
  @@map("block_references")
}

// ---------------------------------------------------------------------------
// Phase 4: Datenbanken (typisiertes EAV, Ansichten)
// ---------------------------------------------------------------------------

enum PageKind {
  PAGE
  DATABASE
  DATABASE_ROW
  /// Phase 9: Zeilen-Vorlage einer Datenbank (parent_id = Datenbank, erscheint in keiner Abfrage)
  ROW_TEMPLATE
  /// Phase 10: Inhalt eines Synced Blocks (parent_id = Ursprungsseite, nicht im Seitenbaum)
  SYNCED_BLOCK
}

/// Property-Typen. relation, rollup und formula folgen in Phase 6.
enum PropertyType {
  title
  text
  number
  select
  multi_select
  status
  date
  person
  checkbox
  url
  email
  phone
  files
  created_time
  created_by
  last_edited_time
  last_edited_by
  unique_id
  relation
  rollup
  formula
  /// Phase 9: löst eine Automatisierung für die Zeile aus (kein gespeicherter Wert)
  button
}

/// Ansichtstypen. Phase 4 setzt table um, die übrigen folgen in Phase 5 und 7.
enum DbViewType {
  table
  board
  list
  gallery
  calendar
  timeline
  chart
}

/// Datenbank. id = id der Datenbankseite (pages.kind = DATABASE).
/// Linked Database: sourceDatabaseId zeigt auf die Quelle, eigene Ansichten, keine eigenen Zeilen.
model Database {
  id               String   @id @db.Uuid
  workspaceId      String   @map("workspace_id") @db.Uuid
  isInline         Boolean  @default(false) @map("is_inline")
  sourceDatabaseId String?  @map("source_database_id") @db.Uuid
  locked           Boolean  @default(false)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  page       Page            @relation("DatabasePage", fields: [id], references: [id], onDelete: Cascade)
  source     Database?       @relation("LinkedDatabase", fields: [sourceDatabaseId], references: [id], onDelete: SetNull)
  linked     Database[]      @relation("LinkedDatabase")
  rows       Page[]          @relation("DatabaseRows")
  properties DbProperty[]
  views      DbView[]
  values     PropertyValue[]
  relations  RelationLink[]

  @@index([workspaceId])
  @@index([sourceDatabaseId])
  @@map("databases")
}

/// Spalte einer Datenbank. config je Typ, validiert mit den Zod-Schemas aus @jotion/shared.
model DbProperty {
  id         String       @id @default(uuid(7)) @db.Uuid
  databaseId String       @map("database_id") @db.Uuid
  type       PropertyType
  name       String
  /// Fractional Index (COLLATE "C"), Standardreihenfolge der Spalten
  position   String
  config     Json         @default("{}")
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  database    Database               @relation(fields: [databaseId], references: [id], onDelete: Cascade)
  values      PropertyValue[]
  links       RelationLink[]
  conversions DbPropertyConversion[]

  @@index([databaseId, position])
  @@map("db_properties")
}

/// Typisiertes EAV: ein Wert je Zeile und Property, Spalte je nach Typ.
/// Leere Werte werden nicht gespeichert (kein Eintrag).
model PropertyValue {
  rowId        String    @map("row_id") @db.Uuid
  propertyId   String    @map("property_id") @db.Uuid
  /// denormalisiert für Indizes und Abfragen je Datenbank
  databaseId   String    @map("database_id") @db.Uuid
  vText        String?   @map("v_text")
  vNumber      Float?    @map("v_number")
  vBool        Boolean?  @map("v_bool")
  vDateStart   DateTime? @map("v_date_start") @db.Timestamptz(3)
  vDateEnd     DateTime? @map("v_date_end") @db.Timestamptz(3)
  vDateHasTime Boolean?  @map("v_date_has_time")
  vTz          String?   @map("v_tz")
  vOptionIds   String[]  @map("v_option_ids") @db.Uuid
  vUserIds     String[]  @map("v_user_ids") @db.Uuid
  vJson        Json?     @map("v_json")
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  row      Page       @relation(fields: [rowId], references: [id], onDelete: Cascade)
  property DbProperty @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  database Database   @relation(fields: [databaseId], references: [id], onDelete: Cascade)

  @@id([rowId, propertyId])
  @@index([propertyId, rowId])
  @@index([databaseId, propertyId, vNumber])
  @@index([databaseId, propertyId, vDateStart])
  @@index([vOptionIds], type: Gin)
  @@index([vUserIds], type: Gin)
  @@index([vText(ops: raw("gin_trgm_ops"))], type: Gin)
  @@map("property_values")
}

/// Relationen (Phase 6). Bei Zwei-Wege-Relationen wird nur eine Kante gespeichert.
model RelationLink {
  databaseId String   @map("database_id") @db.Uuid
  propertyId String   @map("property_id") @db.Uuid
  fromRowId  String   @map("from_row_id") @db.Uuid
  toRowId    String   @map("to_row_id") @db.Uuid
  position   String
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  database Database   @relation(fields: [databaseId], references: [id], onDelete: Cascade)
  property DbProperty @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  fromRow  Page       @relation("RelationFrom", fields: [fromRowId], references: [id], onDelete: Cascade)
  toRow    Page       @relation("RelationTo", fields: [toRowId], references: [id], onDelete: Cascade)

  @@id([propertyId, fromRowId, toRowId])
  @@index([toRowId])
  /// Laden der Verknüpfungen einer Zeile über alle Relationen (Berechnung, Zeilen-DTOs)
  @@index([fromRowId])
  @@map("relation_links")
}

/// Gespeicherte Ansicht. config (Filter, Sortierung, Spalten, Berechnungen) per Zod validiert.
model DbView {
  id         String     @id @default(uuid(7)) @db.Uuid
  databaseId String     @map("database_id") @db.Uuid
  type       DbViewType @default(table)
  name       String
  position   String
  config     Json       @default("{}")
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  database Database         @relation(fields: [databaseId], references: [id], onDelete: Cascade)
  rowOrder DbViewRowOrder[]

  @@index([databaseId, position])
  @@map("db_views")
}

/// Manuelle Reihenfolge je Ansicht (vorgesehen; Phase 4 nutzt die Zeilenposition der Datenbank).
model DbViewRowOrder {
  viewId   String @map("view_id") @db.Uuid
  rowId    String @map("row_id") @db.Uuid
  position String

  view DbView @relation(fields: [viewId], references: [id], onDelete: Cascade)

  @@id([viewId, rowId])
  @@map("db_view_row_order")
}

/// Undo-Snapshot eines Property-Typwechsels (alter Typ, alte Konfiguration, alte Werte).
model DbPropertyConversion {
  id          String       @id @default(uuid(7)) @db.Uuid
  propertyId  String       @map("property_id") @db.Uuid
  fromType    PropertyType @map("from_type")
  fromConfig  Json         @map("from_config")
  toType      PropertyType @map("to_type")
  toConfig    Json         @map("to_config")
  /// [{rowId, value}] im API-Format
  values      Json
  createdById String       @map("created_by_id") @db.Uuid
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  property DbProperty @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId, createdAt])
  @@map("db_property_conversions")
}

/// Phase 7: Dashboard je Nutzer ("user:<id>") oder geteilt im Workspace ("shared").
model Dashboard {
  workspaceId String   @map("workspace_id") @db.Uuid
  key         String
  /// Widgets mit Position im 12-Spalten-Raster, per Zod validiert
  config      Json     @default("{}")
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedById String?  @map("updated_by_id") @db.Uuid

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@id([workspaceId, key])
  @@map("dashboards")
}

/// Phase 8: Verbindung zu einem externen Dienst (iCal-Feed, CalDAV, IServ). Gehört einem Nutzer.
model IntegrationConnection {
  id                  String    @id @default(uuid(7)) @db.Uuid
  workspaceId         String    @map("workspace_id") @db.Uuid
  ownerId             String    @map("owner_id") @db.Uuid
  type                String
  name                String
  /// Nicht geheime Einstellungen (URL, Benutzername)
  config              Json      @default("{}")
  /// Geheimnisse, verschlüsselt mit JOTION_MASTER_KEY (SecretBox, Format v1:...)
  secrets             String?
  /// active, paused, error
  status              String    @default("active")
  statusMessage       String?   @map("status_message")
  accountLabel        String?   @map("account_label")
  syncEnabled         Boolean   @default(true) @map("sync_enabled")
  intervalMinutes     Int       @default(60) @map("interval_minutes")
  nextSyncAt          DateTime? @map("next_sync_at") @db.Timestamptz(3)
  lastSyncAt          DateTime? @map("last_sync_at") @db.Timestamptz(3)
  consecutiveFailures Int       @default(0) @map("consecutive_failures")
  /// Sperre eines laufenden Syncs (Lease, verlängert sich während des Laufs; nach Absturz verfällt sie)
  syncLockId          String?   @map("sync_lock_id") @db.Uuid
  syncLockedUntil     DateTime? @map("sync_locked_until") @db.Timestamptz(3)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sources   IntegrationSource[]
  runs      SyncRun[]

  @@index([workspaceId, ownerId])
  @@index([status, syncEnabled, nextSyncAt])
  @@map("integration_connections")
}

/// Phase 8: Quelle einer Verbindung (Kalender, Feed) mit Ziel-Datenbank und Mapping.
model IntegrationSource {
  id               String    @id @default(uuid(7)) @db.Uuid
  connectionId     String    @map("connection_id") @db.Uuid
  remoteId         String    @map("remote_id")
  name             String
  /// Arten der Datensätze (event, task)
  kinds            String[]
  enabled          Boolean   @default(true)
  targetDatabaseId String?   @map("target_database_id") @db.Uuid
  /// Feldzuordnung, Transformationen, Ownership (per Zod validiert)
  mapping          Json      @default("{}")
  /// Serien, Zeitfenster
  options          Json      @default("{}")
  /// mark, archive, trash
  deletionPolicy   String    @default("mark") @map("deletion_policy")
  /// Fortsetzungspunkt (Sync-Token, ctag, ETag); erst nach erfolgreicher Verarbeitung gespeichert
  cursor           Json?
  lastSyncedAt     DateTime? @map("last_synced_at") @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  connection IntegrationConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  entities   ExternalEntity[]

  @@unique([connectionId, remoteId])
  @@map("integration_sources")
}

/// Phase 8: Zuordnung externer Datensatz zu Zeile. Einziger Weg zum Upsert (keine Dubletten).
model ExternalEntity {
  id              String    @id @default(uuid(7)) @db.Uuid
  sourceId        String    @map("source_id") @db.Uuid
  externalId      String    @map("external_id")
  weakId          Boolean   @default(false) @map("weak_id")
  /// Ressource in der Quelle (CalDAV-href)
  remoteRef       String?   @map("remote_ref")
  /// Phase 11: Beginn des Datensatzes (Schutz vor Löschung außerhalb des Zeitfensters)
  remoteStart     DateTime? @map("remote_start") @db.Timestamptz(3)
  rowId           String?   @map("row_id") @db.Uuid
  /// Hash der zuletzt verarbeiteten Felder
  version         String?
  /// Je Feld der zuletzt synchronisierte Wert (Basis für den Drei-Wege-Vergleich)
  fieldState      Json      @default("{}") @map("field_state")
  remoteDeletedAt DateTime? @map("remote_deleted_at") @db.Timestamptz(3)
  /// Lokal gelöscht: nicht neu anlegen
  suppressed      Boolean   @default(false)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  source    IntegrationSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  row       Page?             @relation(fields: [rowId], references: [id], onDelete: SetNull)
  conflicts SyncConflict[]

  @@unique([sourceId, externalId])
  @@index([sourceId, remoteRef])
  @@index([rowId])
  @@map("external_entities")
}

/// Phase 8: Protokoll eines Sync-Laufs.
model SyncRun {
  id           String    @id @default(uuid(7)) @db.Uuid
  connectionId String    @map("connection_id") @db.Uuid
  /// manual, schedule
  trigger      String
  /// running, succeeded, partial, failed
  status       String    @default("running")
  stats        Json      @default("{}")
  /// Fehler einzelner Datensätze (höchstens 50)
  errors       Json      @default("[]")
  errorMessage String?   @map("error_message")
  startedAt    DateTime  @default(now()) @map("started_at") @db.Timestamptz(3)
  finishedAt   DateTime? @map("finished_at") @db.Timestamptz(3)

  connection IntegrationConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([connectionId, startedAt])
  @@map("sync_runs")
}

/// Phase 8: Feld lokal und remote geändert; lokale Änderung blieb erhalten.
model SyncConflict {
  id          String    @id @default(uuid(7)) @db.Uuid
  entityId    String    @map("entity_id") @db.Uuid
  /// "title" oder Property-ID
  field       String
  localValue  Json?     @map("local_value")
  remoteValue Json?     @map("remote_value")
  baseValue   Json?     @map("base_value")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  resolvedAt  DateTime? @map("resolved_at") @db.Timestamptz(3)
  /// remote (übernommen), local (behalten)
  resolution  String?

  entity ExternalEntity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@index([entityId, field])
  @@map("sync_conflicts")
}

/// Phase 9: Zeilen-Vorlage (Seite kind = ROW_TEMPLATE) mit Standard und Wiederholung.
model DbTemplate {
  pageId     String    @id @map("page_id") @db.Uuid
  databaseId String    @map("database_id") @db.Uuid
  isDefault  Boolean   @default(false) @map("is_default")
  /// { every: day|week|month, time: "HH:MM", weekday?, monthday? }
  recurrence Json?
  nextRunAt  DateTime? @map("next_run_at") @db.Timestamptz(3)
  lastRunAt  DateTime? @map("last_run_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([databaseId])
  @@index([nextRunAt])
  @@map("db_templates")
}

/// Phase 9: Automatisierung (Trigger, Bedingung, Aktionen), läuft als ihr Ersteller.
model Automation {
  id          String    @id @default(uuid(7)) @db.Uuid
  workspaceId String    @map("workspace_id") @db.Uuid
  databaseId  String?   @map("database_id") @db.Uuid
  name        String
  enabled     Boolean   @default(true)
  trigger     Json
  /// Filter-AST wie bei Ansichten (gilt für die auslösende Zeile)
  conditions  Json?
  actions     Json      @default("[]")
  createdById String    @map("created_by_id") @db.Uuid
  /// Geheimnis für signierte Webhooks (SecretBox)
  secret      String?
  nextRunAt   DateTime? @map("next_run_at") @db.Timestamptz(3)
  lastRunAt   DateTime? @map("last_run_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  runs      AutomationRun[]

  @@index([databaseId, enabled])
  @@index([workspaceId])
  @@index([enabled, nextRunAt])
  @@map("automations")
}

/// Phase 9: Ausführungsprotokoll; (automation_id, event_key) macht jede Ausführung idempotent.
model AutomationRun {
  id           String    @id @default(uuid(7)) @db.Uuid
  automationId String    @map("automation_id") @db.Uuid
  eventKey     String    @map("event_key")
  /// running, succeeded, failed, skipped, stopped
  status       String    @default("running")
  chainDepth   Int       @default(0) @map("chain_depth")
  rowId        String?   @map("row_id") @db.Uuid
  actorId      String?   @map("actor_id") @db.Uuid
  /// Ergebnis je Aktion
  details      Json      @default("[]")
  error        String?
  startedAt    DateTime  @default(now()) @map("started_at") @db.Timestamptz(3)
  finishedAt   DateTime? @map("finished_at") @db.Timestamptz(3)

  automation Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)

  @@unique([automationId, eventKey])
  @@index([automationId, startedAt])
  @@map("automation_runs")
}

/// Phase 10: Zugriffsstufe auf eine Seite und ihre Unterseiten
enum PermissionLevel {
  full
  edit
  comment
  view
  none
}

/// Phase 10: Recht eines Mitglieds (user_id) oder aller Mitglieder (user_id NULL) auf eine Seite.
/// Gilt für den Teilbaum; die nächstgelegene Angabe gewinnt (siehe jotion_page_level).
model PagePermission {
  id          String          @id @default(uuid(7)) @db.Uuid
  workspaceId String          @map("workspace_id") @db.Uuid
  pageId      String          @map("page_id") @db.Uuid
  userId      String?         @map("user_id") @db.Uuid
  level       PermissionLevel
  createdById String          @map("created_by_id") @db.Uuid
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  page      Page      @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([pageId])
  @@map("page_permissions")
}

/// Phase 10: Öffentlicher Lese-Link einer Seite (mit Unterseiten)
model PageShareLink {
  pageId      String   @id @map("page_id") @db.Uuid
  token       String   @unique
  createdById String   @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  page        Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@map("page_share_links")
}

/// Phase 10: Kommentar; der erste eines Threads hat thread_id = id
model Comment {
  id           String    @id @default(uuid(7)) @db.Uuid
  workspaceId  String    @map("workspace_id") @db.Uuid
  pageId       String    @map("page_id") @db.Uuid
  threadId     String    @map("thread_id") @db.Uuid
  /// Block, an dem der Thread hängt (null = Seitenkommentar)
  blockId      String?   @map("block_id")
  /// Markierter Text beim Anlegen (Anzeige im Thread)
  quote        String?
  body         String
  mentions     String[]  @db.Uuid
  authorId     String    @map("author_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  editedAt     DateTime? @map("edited_at") @db.Timestamptz(3)
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(3)
  /// Nur am ersten Kommentar eines Threads
  resolvedAt   DateTime? @map("resolved_at") @db.Timestamptz(3)
  resolvedById String?   @map("resolved_by_id") @db.Uuid

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  page      Page      @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([pageId, threadId, createdAt])
  @@map("comments")
}

/// Phase 10: Eintrag im Posteingang
model Notification {
  id          String    @id @default(uuid(7)) @db.Uuid
  workspaceId String    @map("workspace_id") @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  /// mention_page, mention_comment, comment, reply
  type        String
  pageId      String?   @map("page_id") @db.Uuid
  commentId   String?   @map("comment_id") @db.Uuid
  actorId     String?   @map("actor_id") @db.Uuid
  /// Auszug (Text, Blocktyp)
  payload     Json      @default("{}")
  readAt      DateTime? @map("read_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  page      Page?     @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([userId, workspaceId, createdAt])
  @@map("notifications")
}

/// Phase 10: Gespeicherter Stand einer Seite (Historie)
model PageSnapshot {
  id          String   @id @default(uuid(7)) @db.Uuid
  pageId      String   @map("page_id") @db.Uuid
  state       Bytes
  title       String   @default("")
  /// auto, restore
  reason      String   @default("auto")
  createdById String?  @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  page        Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([pageId, createdAt])
  @@map("page_snapshots")
}
