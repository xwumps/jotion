{
  "name": "@jotion/formula",
  "version": "0.1.0",
  "private": true,
  "description": "Formelsprache (Notion-Formula-2.0-kompatibel): Lexer, Parser, Typprüfer, Interpreter",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run"
  },
  "devDependencies": {
    "@jotion/config": "workspace:*",
    "fast-check": "4.10.2",
    "vitest": "3.2.7"
  }
}
