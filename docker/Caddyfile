# Jotion Reverse Proxy.
# JOTION_SITE_ADDRESS: ":80" für LAN/VPN ohne TLS, oder eine Domain für automatisches HTTPS.
{
	admin off
}

{$JOTION_SITE_ADDRESS::80} {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options SAMEORIGIN
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		# Phase 12: Standard-CSP (Antworten mit eigener CSP, z. B. Datei-Downloads, behalten ihre)
		?Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: http: https:; media-src 'self' blob: http: https:; font-src 'self' data:; connect-src 'self' ws: wss:; frame-src 'self' https:; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"
		-Server
	}

	# Server-Sent Events ohne Pufferung durchreichen
	@events path_regexp ^/api/workspaces/[^/]+/events$
	handle @events {
		reverse_proxy api:4000 {
			flush_interval -1
		}
	}

	# REST-API und Realtime-WebSocket (ab Phase 2)
	handle /api/* {
		reverse_proxy api:4000
	}
	handle /collab* {
		reverse_proxy api:4000
	}

	handle {
		reverse_proxy web:3000
	}
}
